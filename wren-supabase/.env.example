# Edge Function secrets — set with `supabase secrets set --env-file supabase/.env`
# (NEVER commit the real values). SUPABASE_URL / SUPABASE_ANON_KEY /
# SUPABASE_SERVICE_ROLE_KEY are injected automatically on the platform for
# deployed functions, but are listed here for local `supabase functions serve`.

# wren-voice: the Anthropic key now lives ONLY here — never in the app binary.
ANTHROPIC_API_KEY=sk-ant-...

# revenuecat-webhook: shared secret; set the SAME value as the Authorization
# header in RevenueCat dashboard → Project → Webhooks.
REVENUECAT_WEBHOOK_SECRET=choose-a-long-random-string

# Optional but recommended: required for sync-entitlement and the webhook's
# recommended source-of-truth path (GET /subscribers/<uid>) and TRANSFER events.
REVENUECAT_REST_API_KEY=rc_secret_...

# Local-serve only (the platform provides these for deployed functions):
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_or_legacy_anon_key
SUPABASE_SERVICE_ROLE_KEY=service-role-key-keep-secret
