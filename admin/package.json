{
  "name": "aigateway-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"ADMIN_DEV=1 tsx watch src/index.ts\" \"bash scripts/pm.sh web dev\"",
    "dev:api": "tsx watch src/index.ts",
    "dev:web": "bash scripts/pm.sh web dev",
    "install:all": "bash scripts/pm.sh install",
    "start": "tsx src/index.ts",
    "build": "bash scripts/pm.sh web build && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migrate:env": "tsx scripts/migrate-env-to-db.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.5",
    "hono": "^4.12.25",
    "openai": "^5.8.2",
    "pg-migration-sql": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "concurrently": "^9.2.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
