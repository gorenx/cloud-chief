# Admin 专用环境变量（复制：cp .env.example .env）
# Worker：../worker/wrangler.toml + ../worker/.dev.vars
# 仓库根 setup.sh / test.sh 也读取本文件

# ========= 管理后台鉴权 ==========
ADMIN_TOKEN=
ADMIN_BIND=127.0.0.1
PORT=8787

# ========= Cloudflare（拉取网关/提供商/BYOK；路由默认从 CF API 解析）=========
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_AIG_TOKEN=

# ========= Playground 本地聊天代理 ==========
DASHSCOPE_API_KEY=
MODEL=qwen3-max

# ========= Worker 部署面板（可选）=========
# spawn wrangler 时注入；wrangler 自身配置仍读 worker/ 目录
CLOUDFLARE_API_TOKEN=
WORKER_DIR=../worker
WORKER_ROOT=..
