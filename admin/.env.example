# Admin 专用环境变量（复制：cp .env.example .env）
# Worker：../worker/wrangler.toml + ../worker/.dev.vars
# 仓库根 setup.sh / test.sh 也读取本文件

# ========= 管理后台鉴权 ==========
ADMIN_TOKEN=
ADMIN_BIND=127.0.0.1
PORT=8787

# ========= Cloudflare（拉取网关/提供商/BYOK；路由默认从 CF API 解析）=========
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_AIG_TOKEN=

# ========= Playground 本地聊天代理 ==========
DASHSCOPE_API_KEY=
MODEL=qwen3-max
# 模型下拉列表（逗号分隔 id；留空=展示 model-catalog.ts 全部；缺失时 /config 会自动追加）
MODEL_CATALOG=qwen3-max,qwen3-plus,qwen-plus,qwen-flash

# ========= Playground Worker 调试（可选）=========
# 本地 wrangler dev：填 http://127.0.0.1:8788（回环地址优先于 CF workers.dev）
# 留空或删此行：有 CF_API_TOKEN 时自动解析 https://{name}.{subdomain}.workers.dev
WORKER_URL=http://127.0.0.1:8788
# 用于 Admin 代换 Supabase access_token（勿提交真实密码）
SUPABASE_ANON_KEY=
SUPABASE_TEST_EMAIL=
SUPABASE_TEST_PASSWORD=
# Supabase 平台 OAuth（Organization Settings → OAuth Apps → Add application）
# 须勾选 Projects Read + Database Read/Write（步骤 4 数据库迁移需要后者）
# Callback：须 HTTPS，localhost 可用 HTTP → 用 http://localhost:5173/...（勿用 127.0.0.1）
# 控制台：https://supabase.com/dashboard/org/_/apps
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
SUPABASE_OAUTH_REDIRECT_URI=http://localhost:5173/admin/supabase/oauth/callback
ADMIN_WEB_ORIGIN=http://localhost:5173

# ========= Worker 部署面板（可选）=========
# spawn wrangler 时注入；wrangler 自身配置仍读 worker/ 目录
CLOUDFLARE_API_TOKEN=
# Workers Builds / GitHub CI（用户 Token：Workers CI Edit + Workers Scripts Read）
CF_WORKER_BUILDER=
WORKER_DIR=../worker
WORKER_ROOT=..
