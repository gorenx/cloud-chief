# admin 配置服务读取的环境变量。本服务默认从仓库根目录的 .env 读取，
# 也可以在 admin/.env 覆盖。以下为新增/相关项：

# ========= 管理后台鉴权（必填）=========
# 访问 /admin/* 需要在请求头带 Authorization: Bearer <ADMIN_TOKEN>。
# 不设置则管理接口全部拒绝。用一段足够随机的长字符串。
ADMIN_TOKEN=

# 监听地址与端口。默认只绑 127.0.0.1（仅本机可访问）。
# 如需局域网访问改成 0.0.0.0（请确保 ADMIN_TOKEN 足够强）。
ADMIN_BIND=127.0.0.1
PORT=8787

# ========= Cloudflare 账号（管理网关/提供商/BYOK）=========
CF_ACCOUNT_ID=
# 管理资源用的 API Token：AI Gateway - Edit（管 BYOK 还需 Secrets Store - Edit）
CF_API_TOKEN=
CF_GATEWAY_ID=qwen-gw
CF_AIG_TOKEN=

# ========= 自定义提供商 / 聊天代理（本地调试用）=========
PROVIDER_SLUG=
PROVIDER_BASE_URL=
PROVIDER_PATH=/compatible-mode/v1/responses
DASHSCOPE_API_KEY=
MODEL=qwen3.7-plus

# ========= Worker 部署（可选）=========
# 部署功能调用 wrangler CLI。wrangler 需自身已登录（wrangler login）
# 或设置 CLOUDFLARE_API_TOKEN（权限：Workers Scripts - Edit）。
# 下面这个会在 spawn wrangler 时注入给子进程。
CLOUDFLARE_API_TOKEN=
# worker 工程目录（相对 admin/ 或绝对路径），默认 ../worker
WORKER_DIR=../worker
