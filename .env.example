# ========= Cloudflare 账号 =========
# 在 Cloudflare 控制台右侧栏可以看到 Account ID
CF_ACCOUNT_ID=

# API Token（配置后台用它调 Cloudflare API）。权限要求：
#   - 管理网关/自定义提供商：AI Gateway - Edit
#   - 管理 BYOK 存储密钥：再加 Secrets Store - Edit
# https://dash.cloudflare.com/profile/api-tokens
CF_API_TOKEN=

# AI Gateway 的网关 ID（名称）。建议用专属命名网关，不要用 default
# （default 是账号默认网关，authentication 无法稳定关闭，会间歇 401）
CF_GATEWAY_ID=qwen-gw

# 网关令牌（cf-aig-authorization）。在网关「Authenticated Gateway」里创建。
# 填了它 setup.sh 会开启网关鉴权，请求需带此令牌；留空则关闭网关鉴权。
CF_AIG_TOKEN=

# ========= 自定义提供商（阿里云 MaaS / qwen） =========
# 自定义提供商的 slug（只能用字母数字和连字符），可自定义
PROVIDER_SLUG=qwen-beijing-maas

# 提供商根域名（注意：不要带 /compatible-mode 等路径）
PROVIDER_BASE_URL=https://ws-3mll18ey04t6yc61.cn-beijing.maas.aliyuncs.com

# 上游真实路径（拼在 base_url 后面）。本项目用阿里云 Responses API：/compatible-mode/v1/responses
PROVIDER_PATH=/compatible-mode/v1/responses

# 阿里云 DashScope / 百炼 的 API Key（即调用上游所需的 Bearer Token）
DASHSCOPE_API_KEY=

# 默认模型。注意：Responses API 不支持无版本的 qwen-max
# 可用：qwen3-max / qwen3.7-max / qwen-plus / qwen-flash 等
MODEL=qwen3-max

# ========= admin 配置服务（admin/）=========
# 访问 /admin/* 管理接口所需令牌。不设置则管理接口全部拒绝。用足够随机的长字符串。
ADMIN_TOKEN=
# 监听地址（默认仅本机）；如需局域网访问改 0.0.0.0，并确保 ADMIN_TOKEN 足够强。
ADMIN_BIND=127.0.0.1
# 本地 Web 服务端口
PORT=8787

# ========= Worker 部署（admin 后台触发，可选）=========
# 部署调用本机 wrangler，需其已登录（wrangler login）或设此 token（权限 Workers Scripts - Edit）。
CLOUDFLARE_API_TOKEN=
